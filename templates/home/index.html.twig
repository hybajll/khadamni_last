{% extends 'base.html.twig' %}

{% block title %}خدمني — Accueil{% endblock %}

{% block main_container_open %}<div class="container-fluid px-0">{% endblock %}
{% block main_container_close %}</div>{% endblock %}

{% block stylesheets %}
    <style>
        :root{
            --kh-surface: #fff;
            --kh-muted: rgba(255,255,255,.78);
        }

        .landing-hero{
            position: relative;
            color: #fff;
            overflow: hidden;
            background:
                radial-gradient(1200px 520px at 10% 15%, rgba(255, 140, 0, 0.28), transparent 62%),
                radial-gradient(900px 520px at 85% 40%, rgba(255, 255, 255, 0.16), transparent 62%),
                linear-gradient(135deg, var(--kh-navy) 0%, #0c2a50 55%, #071a30 100%);
        }
        .landing-hero::after{
            content:"";
            position:absolute;
            inset:-1px;
            background-image: radial-gradient(rgba(255,255,255,0.10) 1px, transparent 1px);
            background-size: 18px 18px;
            opacity: .30;
            pointer-events:none;
        }
        .hero-inner{
            position:relative;
            z-index:1;
            padding: clamp(56px, 7vw, 90px) 0 clamp(28px, 3vw, 38px);
        }
        .hero-brand{
            font-family: "Cairo", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
            font-weight: 900;
            letter-spacing: .2px;
        }
        .hero-brand .name{
            font-size: clamp(2.4rem, 5vw, 4.2rem);
            line-height: 1.02;
        }
        .hero-brand .tagline{
            margin-top: 8px;
            font-size: 1.08rem;
            color: var(--kh-muted);
            font-weight: 700;
        }
        .hero-copy{
            max-width: 56ch;
            margin-top: 14px;
            color: rgba(255,255,255,.90);
            line-height: 1.75;
            font-size: 1.02rem;
        }
        .hero-actions .btn{
            border-radius: 999px;
            padding: .92rem 1.2rem;
            font-weight: 900;
            letter-spacing: .2px;
        }
        .btn-hero-secondary{
            background: rgba(255,255,255,0.10);
            border: 1px solid rgba(255,255,255,0.28);
            color: #fff;
        }
        .btn-hero-secondary:hover{
            background: rgba(255,255,255,0.16);
            border-color: rgba(255,255,255,0.38);
            color:#fff;
        }

        .hero-pills{
            margin-top: 18px;
            display:flex;
            gap:10px;
            flex-wrap:wrap;
        }
        .hero-pill{
            display:inline-flex;
            align-items:center;
            gap:10px;
            padding: 10px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,0.10);
            border: 1px solid rgba(255,255,255,0.18);
            color: rgba(255,255,255,0.92);
            font-weight: 900;
            font-size:.95rem;
        }
        .hero-pill .dot{
            width:10px;height:10px;border-radius:999px;background: var(--kh-orange);
            box-shadow: 0 0 0 6px rgba(255,140,0,.18);
        }

        .hero-fade-up{ animation: fadeUp 720ms cubic-bezier(.2,.8,.2,1) both; }
        .hero-fade-up.delay-1{ animation-delay: 80ms; }
        .hero-fade-up.delay-2{ animation-delay: 160ms; }
        .hero-fade-up.delay-3{ animation-delay: 240ms; }
        @keyframes fadeUp{ from{opacity:0; transform: translateY(10px);} to{opacity:1; transform: translateY(0);} }

        .stats-strip{
            position:relative;
            z-index:1;
            margin-top: 22px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.14);
            border-radius: 18px;
            backdrop-filter: blur(8px);
        }
        .stats-strip .stat{
            padding: 16px 18px;
            min-width: 170px;
        }
        .stat .k{
            font-weight: 900;
            font-size: 1.5rem;
            line-height: 1.1;
        }
        .stat .l{
            color: rgba(255,255,255,.78);
            font-weight: 700;
            font-size: .95rem;
        }

        .landing-section{ padding: 46px 0; }
        .landing-surface{
            background: #fff;
            border-radius: 22px;
            border: 1px solid rgba(0,0,0,0.06);
            box-shadow: 0 18px 46px rgba(10,30,60,0.10);
        }
        .landing-surface.padded{ padding: 22px; }
        @media (min-width: 992px){
            .landing-surface.padded{ padding: 28px; }
        }

        .section-title{
            font-weight: 900;
            letter-spacing: .2px;
            color: #0e223a;
        }
        .section-subtitle{ color: rgba(14,34,58,.70); }

        .how-grid{
            display:grid;
            grid-template-columns: 1fr;
            gap: 14px;
        }
        @media (min-width: 992px){
            .how-grid{ grid-template-columns: 1fr 1fr; gap: 18px; }
        }

        .how-card{
            border-radius: 18px;
            padding: 18px;
            border: 1px solid rgba(0,0,0,0.06);
            background: linear-gradient(180deg, #fff 0%, #fbfcff 100%);
        }
        .how-card .badge{
            background: rgba(255,140,0,.14);
            color: #8a4b00;
            border: 1px solid rgba(255,140,0,.25);
        }
        .how-steps{
            margin: 12px 0 0;
            padding-left: 18px;
            color: rgba(14,34,58,.82);
        }
        .how-steps li{ margin: 6px 0; }


        .offers-wrap .offer-row{
            padding: 16px 0;
            border-bottom: 1px solid rgba(0,0,0,0.06);
        }
        .offers-wrap .offer-row:last-child{ border-bottom: 0; padding-bottom: 0; }
        .offer-title{ font-weight: 900; margin: 0; color: #0e223a; }
        .offer-meta{ color: rgba(14,34,58,.70); font-size: .95rem; }

        .reveal{
            opacity: 0;
            transform: translateY(10px);
            transition: opacity .5s ease, transform .5s ease;
        }
        .reveal.is-visible{
            opacity: 1;
            transform: translateY(0);
        }
    </style>
{% endblock %}

{% block body %}
    <header class="landing-hero">
        <div class="container hero-inner">
            <div class="row align-items-center g-4">
                <div class="col-lg-12">
                    <div class="hero-brand hero-fade-up">
                        <div class="name">خدمني</div>
                        <div class="tagline">خدمتك معانا مضمونة</div>
                    </div>

                    <div class="hero-copy hero-fade-up delay-1">
                        اكتشف آخر العروض، وحسّن سيرتك الذاتية بطريقة احترافية.
                        إذا كنت شركة، انشر عروضك وشاهد المرشحين الأكثر توافقًا.
                    </div>

                    <div class="hero-actions d-flex gap-2 flex-wrap mt-3 hero-fade-up delay-2">
                        <a class="btn btn-primary" href="{{ path('app_login') }}">أنا مرشح (تسجيل الدخول)</a>
                        <a class="btn btn-hero-secondary" href="{{ path('society_login') }}">أنا شركة (تسجيل الدخول)</a>
                        <a class="btn btn-outline-light" href="#latest-offers">تصفّح آخر العروض</a>
                    </div>

                    <div class="hero-pills hero-fade-up delay-3">
                        <span class="hero-pill"><span class="dot"></span>منصّة بسيطة وسريعة</span>
                        <span class="hero-pill"><span class="dot"></span>CV منظم وجاهز</span>
                        <span class="hero-pill"><span class="dot"></span>اقتراحات فرص مناسبة</span>
                    </div>

                    <div class="stats-strip mt-4 d-flex flex-wrap align-items-stretch">
                        <div class="stat">
                            <div class="k">{{ stats.candidates|default(0) }}</div>
                            <div class="l">مرشّحون</div>
                        </div>
                        <div class="stat">
                            <div class="k">{{ stats.societies|default(0) }}</div>
                            <div class="l">شركات</div>
                        </div>
                        <div class="stat">
                            <div class="k">{{ stats.offers|default(0) }}</div>
                            <div class="l">عروض نشطة</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <section class="landing-section">
        <div class="container">
            <div class="how-grid">
                <div class="how-card reveal">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <div class="section-title h5 mb-1">للمرشّحين</div>
                            <div class="section-subtitle">سيرة ذاتية قوية + ترشيحات فرص مناسبة</div>
                        </div>
                        <span class="badge rounded-pill">Candidat</span>
                    </div>
                    <ol class="how-steps">
                        <li>أنشئ حسابًا (طالب / خريج).</li>
                        <li>ارفع CV PDF أو اكتب محتواك.</li>
                        <li>حسّن السيرة الذاتية وابدأ التقديم.</li>
                    </ol>
                    <div class="mt-3 d-flex gap-2 flex-wrap">
                        <a class="btn btn-sm btn-primary" href="{{ path('app_register') }}">إنشاء حساب مرشح</a>
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_login') }}">تسجيل الدخول</a>
                    </div>
                </div>

                <div class="how-card reveal">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <div class="section-title h5 mb-1">للشركات</div>
                            <div class="section-subtitle">انشر عروضك وشاهد المرشحين</div>
                        </div>
                        <span class="badge rounded-pill">Entreprise</span>
                    </div>
                    <ol class="how-steps">
                        <li>أنشئ حساب شركة.</li>
                        <li>انشر عرضًا في ثوانٍ.</li>
                        <li>اطّلع على قائمة المتقدمين والتوصيات.</li>
                    </ol>
                    <div class="mt-3 d-flex gap-2 flex-wrap">
                        <a class="btn btn-sm btn-primary" href="{{ path('society_register') }}">إنشاء حساب شركة</a>
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('society_login') }}">تسجيل الدخول</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="latest-offers" class="landing-section">
        <div class="container">
            <div class="d-flex align-items-end justify-content-between flex-wrap gap-3 mb-3">
                <div class="reveal">
                    <h2 class="section-title h4 mb-1">Dernières offres</h2>
                    <div class="section-subtitle">Cliquez pour voir le détail. Pour postuler : connexion candidat.</div>
                </div>
                <div class="d-flex gap-2 flex-wrap reveal">
                    <a class="btn btn-outline-primary" href="{{ path('app_register') }}">Créer un compte candidat</a>
                    <a class="btn btn-outline-primary" href="{{ path('society_register') }}">Créer un compte entreprise</a>
                </div>
            </div>

            <div class="landing-surface padded offers-wrap reveal">
                {% if offers is empty %}
                    <div class="text-muted">Aucune offre active pour le moment.</div>
                {% else %}
                    {% for offer in offers %}
                        <div class="offer-row">
                            <div class="d-flex align-items-start justify-content-between gap-3">
                                <div class="flex-grow-1">
                                    <h3 class="offer-title h6">
                                        <a class="text-decoration-none" style="color: inherit;" href="{{ path('app_offer_public_show', {id: offer.id}) }}">
                                            {{ offer.title }}
                                        </a>
                                    </h3>
                                    <div class="offer-meta mt-1">
                                        {{ offer.society.name }}
                                        {% if offer.location %} • {{ offer.location }}{% endif %}
                                        {% if offer.contractType %} • {{ offer.contractType }}{% endif %}
                                    </div>
                                </div>
                                <div class="text-nowrap d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_offer_public_show', {id: offer.id}) }}">Voir</a>
                                    <a class="btn btn-sm btn-primary" href="{{ path('app_candidature_new', {offer: offer.id}) }}">Postuler</a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </section>

    <script>
        (function () {
            const observer = new IntersectionObserver((entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) entry.target.classList.add('is-visible');
                }
            }, { threshold: 0.12 });
            document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
        })();
    </script>
{% endblock %}
