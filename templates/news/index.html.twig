{% extends 'base.html.twig' %}

{% block title %}News Feed — Khadamni{% endblock %}

{% block body %}
    <div class="container py-5">
        {# Section: Créer une news #}
        <div class="mb-5">
            <div class="bg-white rounded-4 p-4 p-md-5 shadow-sm border-0">
                <h2 class="h5 fw-bold text-darken mb-4">
                    <i class="fas fa-feather-alt text-orange me-2"></i>Partager une actualité
                </h2>
                
                {{ form_start(form, {'attr': {'class': 'needs-validation', 'enctype': 'multipart/form-data'}}) }}
                    <div class="row g-3">
                        <div class="col-md-8">
                            <div class="form-group">
                                {{ form_widget(form.title, {
                                    'attr': {
                                        'class': 'form-control form-control-lg',
                                        'placeholder': 'Titre de l\'actualité'
                                    }
                                }) }}
                                <small class="text-muted d-block mt-1">
                                    Donnez un titre accrocheur à votre actualité
                                </small>
                            </div>
                        </div>

                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                <i class="fas fa-paper-plane me-2"></i>Publier
                            </button>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-12">
                            <div class="form-group">
                                {{ form_widget(form.content, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Contenu complet de votre actualité',
                                        'rows': 4
                                    }
                                }) }}
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_widget(form.imageUrl, {
                                    'attr': {
                                        'class': 'form-control form-control-sm',
                                        'accept': 'image/*'
                                    }
                                }) }}
                            </div>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        {# Section: Liste des actualités #}
        <div>
            <h2 class="h4 fw-bold text-darken mb-4">
                <i class="fas fa-newspaper text-orange me-2"></i>Actualités
            </h2>

            {% if allNews|length > 0 %}
                <div class="row g-4">
                    {% for news in allNews %}
                        <div class="col-lg-8">
                            <article class="card border-0 shadow-sm overflow-hidden transition-all hover-lift h-100">
                                {# Image de la news #}
                                {% if news.imageUrl %}
                                    <div class="position-relative" style="height: 300px; overflow: hidden;">
                                        <img src="{{ news.imageUrl }}" alt="{{ news.title }}" class="w-100 h-100 object-fit-cover">
                                        
                                        {# Badge offre web #}
                                        {% if news.isExternal %}
                                            <span class="position-absolute top-0 end-0 m-3 badge bg-warning text-dark fw-bold">
                                                <i class="fas fa-globe me-1"></i>OFFRE WEB
                                            </span>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <div class="bg-light p-4 border-bottom" style="min-height: 150px; background: linear-gradient(135deg, rgba(255, 140, 0, 0.08) 0%, rgba(10, 35, 64, 0.08) 100%); display: flex; align-items: center; justify-content: center;">
                                        {% if news.isExternal %}
                                            <span class="badge bg-warning text-dark fw-bold">
                                                <i class="fas fa-globe me-1"></i>OFFRE WEB
                                            </span>
                                        {% else %}
                                            <i class="fas fa-image text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                                        {% endif %}
                                    </div>
                                {% endif %}

                                <div class="card-body">
                                    {# En-tête: Auteur et date #}
                                    <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-orange" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                                                {% if news.user %}
                                                    {{ news.user.nom|first|upper }}
                                                {% else %}
                                                    {{ news.authorType|first|upper }}
                                                {% endif %}
                                            </div>
                                            <div>
                                                <p class="mb-0 fw-bold text-darken small">
                                                    {% if news.user %}
                                                        {{ news.user.nom }}
                                                    {% else %}
                                                        {{ news.authorType }}
                                                    {% endif %}
                                                </p>
                                                <p class="mb-0 text-muted small">
                                                    <i class="fas fa-clock me-1"></i>{{ news.createdAt|date('d/m/Y H:i') }}
                                                </p>
                                            </div>
                                        </div>
                                        {% if news.isExternal %}
                                            <span class="badge bg-info text-white">{{ news.authorType }}</span>
                                        {% endif %}
                                    </div>

                                    {# Titre #}
                                    <h3 class="h5 fw-bold text-darken mb-3">
                                        {% if news.isExternal and news.sourceLink %}
                                            <a href="{{ news.sourceLink }}" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-darken">
                                                {{ news.title }}
                                            </a>
                                        {% else %}
                                            <a href="{{ path('app_news_show', {'id': news.id}) }}" class="text-decoration-none text-darken">
                                                {{ news.title }}
                                            </a>
                                        {% endif %}
                                    </h3>

                                    {# Contenu #}
                                    <p class="text-darken mb-4 lh-lg">
                                        {{ news.content|u.truncate(250, '...') }}
                                    </p>

                                    {# Actions: Like, Commentaires, Lien externe #}
                                    <div class="d-flex align-items-center justify-content-between mb-4 pt-3 border-top">
                                        {% if not news.isExternal %}
                                            <div class="d-flex gap-3 align-items-center">
                                                <form method="post" action="{{ path('app_news_like', {'id': news.id}) }}" style="display: inline;">
                                                    <button type="submit" class="btn btn-sm btn-light text-darken fw-500 rounded-3" title="J'aime">
                                                        <i class="fas fa-heart me-2" style="color: {% if app.user and news.likedByUsers.contains(app.user) %}#e74c3c{% else %}#dc3545{% endif %};"></i><span>J'aime</span>
                                                    </button>
                                                </form>
                                                <small class="text-muted">{{ news.likes ?? 0 }}</small>
                                                <button class="btn btn-sm btn-light text-darken fw-500 rounded-3" title="Commenter">
                                                    <i class="fas fa-comment text-primary me-2"></i><span>Commenter</span>
                                                </button>
                                            </div>
                                        {% endif %}

                                        {% if news.isExternal and news.sourceLink %}
                                            <a href="{{ news.sourceLink }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary rounded-3 fw-500">
                                                <i class="fas fa-external-link-alt me-1"></i>Voir la source
                                            </a>
                                        {% else %}
                                            <a href="{{ path('app_news_show', {'id': news.id}) }}" class="btn btn-sm btn-outline-primary rounded-3 fw-500">
                                                <i class="fas fa-arrow-right me-1"></i>Lire plus
                                            </a>
                                        {% endif %}
                                    </div>

                                    {# Derniers commentaires et formulaire - SEULEMENT POUR LES NEWS INTERNES #}
                                    {% if not news.isExternal %}
                                        <div class="mt-4">
                                            {% if news.comments is not empty %}
                                                <div class="bg-light rounded-3 p-3 mb-3">
                                                    <p class="text-muted small fw-bold mb-3">
                                                        <i class="fas fa-comments me-2"></i>Derniers commentaires
                                                    </p>

                                                    {% set lastComments = news.comments|reverse|slice(0, 2) %}
                                                    {% for comment in lastComments %}
                                                        <div class="mb-3 pb-3 {% if not loop.last %}border-bottom{% endif %}">
                                                            <div class="d-flex align-items-start gap-2">
                                                                <div class="rounded-circle bg-secondary-subtle" style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                                                    <i class="fas fa-user text-muted small"></i>
                                                                </div>
                                                                <div style="flex: 1;">
                                                                    <p class="mb-1">
                                                                        <small class="text-muted">
                                                                            <span class="fw-bold text-darken">Utilisateur</span>
                                                                            • {{ comment.createdAt|date('d/m/Y H:i') }}
                                                                        </small>
                                                                    </p>
                                                                    <p class="mb-2 small text-darken">
                                                                        {{ comment.content|u.truncate(100, '...') }}
                                                                    </p>
                                                                    <small class="d-flex align-items-center gap-2">
                                                                        <form method="post" action="{{ path('app_comment_like', {'id': comment.id}) }}" style="display: inline;">
                                                                            <button type="submit" class="btn btn-sm p-0 text-decoration-none" style="background: none; border: none; cursor: pointer;">
                                                                                <i class="fas fa-heart" style="color: {% if app.user and comment.likedByUsers.contains(app.user) %}#e74c3c{% else %}#ccc{% endif %};"></i>
                                                                            </button>
                                                                        </form>
                                                                        <span class="text-muted">{{ comment.likes ?? 0 }}</span>
                                                                    </small>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}

                                            {# Formulaire d'ajout de commentaire #}
                                            <form method="post" action="{{ path('app_news_add_comment', {'id': news.id}) }}" class="d-flex gap-2">
                                                <input 
                                                    type="text" 
                                                    name="comment_content" 
                                                    class="form-control form-control-sm rounded-3" 
                                                    placeholder="Ajouter un commentaire..."
                                                    required
                                                />
                                                <button type="submit" class="btn btn-sm btn-primary rounded-3">
                                                    <i class="fas fa-paper-plane"></i>
                                                </button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </div>
                            </article>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="alert alert-info rounded-4 py-5 text-center border-0 bg-light">
                    <i class="fas fa-inbox" style="font-size: 3rem; color: #0a2340; opacity: 0.4;"></i>
                    <p class="mt-3 mb-0 text-muted">
                        Aucune actualité pour le moment. 
                        <a href="#" class="text-orange text-decoration-none fw-bold">Soyez le premier à partager !</a>
                    </p>
                </div>
            {% endif %}
        </div>
    </div>

    <style>
        .transition-all {
            transition: all 0.3s ease;
        }

        .hover-lift:hover {
            transform: translateY(-4px);
            box-shadow: 0 1.5rem 3rem rgba(15, 23, 42, 0.15) !important;
        }

        .object-fit-cover {
            object-fit: cover;
        }

        .fw-500 {
            font-weight: 500;
        }

        .rounded-3 {
            border-radius: 0.5rem;
        }

        .btn-light {
            background-color: rgba(10, 35, 64, 0.05) !important;
            border: 1px solid rgba(10, 35, 64, 0.1) !important;
        }

        .btn-light:hover {
            background-color: rgba(10, 35, 64, 0.1) !important;
        }

        .bg-secondary-subtle {
            background-color: rgba(108, 117, 125, 0.1) !important;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--kh-orange);
            box-shadow: 0 0 0 0.2rem rgba(255, 140, 0, 0.25);
        }
    </style>
{% endblock %}
