{% extends 'base.html.twig' %}

{% block body %}

<style>
:root {
    --accent-orange: #ffb100;
    --dark: #1e293b;
    --light-bg: #f8fafc;
    --white: #ffffff;
    --border: #e2e8f0;
    --text: #0f172a;
    --muted: #64748b;
}

/* BASE */
html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: var(--light-bg);
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: var(--text);
}

/* LAYOUT PRINCIPAL */
.main-wrapper {
    display: flex;
    gap: 20px;
    padding: 20px;
    min-height: calc(100vh - 40px);
    align-items: stretch;
}

/* SIDEBAR */
.sidebar-list {
    width: 340px;
    min-width: 300px;
    max-width: 380px;
    background: var(--white);
    border-radius: 16px;
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

/* CONTENT */
.content-area {
    flex: 1;
    background: var(--white);
    border-radius: 16px;
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

/* HEADER SIDEBAR */
.sidebar-list .p-3 {
    background: var(--dark);
    color: white;
}

/* ITEMS */
.ticket-item {
    padding: 14px 16px;
    border-bottom: 1px solid #f1f5f9;
    cursor: pointer;
    transition: 0.25s ease;
}

.ticket-item:hover {
    background: #fffdf5;
}

.ticket-item.active {
    background: #fff7db;
    border-left: 5px solid var(--accent-orange);
}

/* CHAT */
.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    background: #f8fafc;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

/* BUBBLES - CORRECTION ALIGNEMENT */
.bubble {
    max-width: 75%;
    padding: 10px 16px;
    border-radius: 18px;
    word-wrap: break-word;
    line-height: 1.4;
}

/* Message utilisateur (à droite) */
.bubble-user {
    align-self: flex-end;
    background: var(--dark);
    color: white;
    border-bottom-right-radius: 4px;
}

/* Message admin (à gauche) */
.bubble-admin {
    align-self: flex-start;
    background: white;
    border: 1px solid var(--border);
    border-bottom-left-radius: 4px;
    color: var(--text);
}

/* Timestamp dans les bulles */
.bubble small {
    display: block;
    margin-top: 6px;
    font-size: 0.7rem;
    opacity: 0.75;
}

/* Timestamp spécifique pour le message utilisateur (plus clair) */
.bubble-user small {
    color: rgba(255, 255, 255, 0.7);
}

/* Timestamp pour le message admin */
.bubble-admin small {
    color: var(--muted);
}

/* FORM AREA CHAT */
#view-chat .p-3.border-top {
    background: white;
}

/* FORM CREATE - STYLE ADMIN */
.form-card {
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
}

.form-header {
    background-color: #2c3e50;
    color: white;
    padding: 1.5rem;
}

.btn-save {
    background-color: #27ae60;
    color: white;
    transition: 0.3s;
}

.btn-save:hover {
    background-color: #2ecc71;
    transform: translateY(-1px);
}

#view-create .form-control,
#view-create .form-select {
    border-radius: 8px;
}

#view-create .form-control:focus,
#view-create .form-select:focus {
    border-color: #ffb100;
    box-shadow: 0 0 0 0.2rem rgba(255, 177, 0, 0.15);
}

#view-create hr {
    border-top: 1px solid #dee2e6;
}

/* RESPONSIVE */
@media (max-width: 992px) {
    .main-wrapper {
        flex-direction: column;
    }

    .sidebar-list {
        width: 100%;
        max-width: 100%;
    }

    .content-area {
        min-height: 500px;
    }
}

/* Corrections supplémentaires */
.ticket-item small.text-muted,
.ticket-item .small.text-muted {
    font-size: 0.75rem;
}

.ticket-item .badge {
    font-size: 0.7rem;
    padding: 0.25rem 0.5rem;
}

#reply-form .form-control {
    border: 1px solid var(--border);
    transition: all 0.2s ease;
}

#reply-form .form-control:focus {
    border-color: var(--accent-orange);
    box-shadow: 0 0 0 0.2rem rgba(255, 177, 0, 0.1);
}

#reply-form button {
    transition: all 0.2s ease;
}

#reply-form button:hover {
    transform: scale(1.05);
    background-color: #e6a000;
}

/* Animation pour le chargement */
.ticket-item {
    transition: all 0.25s ease;
}

/* Scrollbar personnalisée pour chat-messages */
.chat-messages::-webkit-scrollbar {
    width: 6px;
}

.chat-messages::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 3px;
}

.chat-messages::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 3px;
}

.chat-messages::-webkit-scrollbar-thumb:hover {
    background: var(--muted);
}

/* Correction pour les espaces */
#view-create .mx-auto {
    width: 100%;
}

/* Amélioration responsive pour les bulles */
@media (max-width: 768px) {
    .bubble {
        max-width: 85%;
    }
    
    .main-wrapper {
        padding: 10px;
        gap: 10px;
    }
    
    .chat-messages {
        padding: 15px;
    }
}

/* Correction de l'affichage du conteneur principal */
.container-fluid {
    padding-left: 0;
    padding-right: 0;
}

/* Ajustement du titre principal pour qu'il ne dépasse pas */
.container-fluid > .d-flex {
    padding-left: 20px;
    padding-right: 20px;
}
</style>

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 px-3">
        <h4 class="fw-bold text-dark">
            <i class="fas fa-headset me-2"></i>
            Support Khadamni
        </h4>

        <button class="btn btn-warning text-white fw-bold rounded-pill shadow-sm"
                onclick="showCreateForm()">
            <i class="fas fa-plus me-1"></i>
            Nouvelle Réclamation
        </button>
    </div>

    <div class="main-wrapper">

        <!-- LISTE -->
        <div class="sidebar-list shadow-sm">
            <div class="p-3 bg-dark text-white fw-bold">
                Historique
            </div>

            <div class="overflow-auto" style="max-height:600px;">
                {% for rec in reclamations %}
                    <div class="ticket-item"
                         id="ticket-{{ rec.idReclamation }}"
                         onclick="loadChat('{{ rec.idReclamation }}','{{ rec.sujet|escape('js') }}')">

                        <div class="d-flex justify-content-between">
                            <span class="small text-muted">
                                {{ rec.dateCreation|date('d/m/Y') }}
                            </span>

                            <span class="badge bg-light text-dark">
                                {{ rec.statut.value ?? rec.statut }}
                            </span>
                        </div>

                        <div class="fw-bold mt-1 text-truncate">
                            {{ rec.sujet }}
                        </div>
                    </div>

                    <!-- DATA JSON -->
                    <script type="application/json" id="data-{{ rec.idReclamation }}">
                    {
                        "token":"{{ csrf_token('reply' ~ rec.idReclamation) }}",
                        "replyUrl":"{{ is_granted('ROLE_SOCIETY') 
                            ? path('app_society_reclamation_reply', {'id': rec.idReclamation}) 
                            : path('app_user_reclamation_reply', {'id': rec.idReclamation}) }}",
                        "messages":[
                            {
                                "type":"user",
                                "msg":"{{ rec.description|escape('js') }}",
                                "time":"{{ rec.dateCreation|date('H:i') }}"
                            }
                            {% for rep in rec.reponseReclamations %}
                            ,{
                                "type":"{{ (rep.auteur or rep.societyAuteur) ? 'user' : 'admin' }}",
                                "msg":"{{ rep.message|escape('js') }}",
                                "time":"{{ rep.dateReponse|date('H:i') }}"
                            }
                            {% endfor %}
                        ]
                    }
                    </script>
                {% else %}
                    <div class="p-5 text-center text-muted">
                        Aucune réclamation.
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- CONTENU -->
        <div class="content-area shadow-sm">

            <div id="view-create" class="p-4">
                <div class="mx-auto" style="max-width: 650px;">
                    <div class="form-card shadow-lg">
                        {# Header #}
                        <div class="form-header d-flex align-items-center">
                            
                        </div>

                        <div class="p-4">
                            {{ form_start(form) }}
                                {# Sujet #}
                                <div class="mb-3">
                                    <label class="fw-bold mb-1">Sujet :</label>
                                    {{ form_widget(form.sujet, {
                                        'attr': {
                                            'class': 'form-control border-secondary-subtle',
                                            'placeholder': 'Ex: Problème d\'accès au profil'
                                        }
                                    }) }}
                                    <div class="text-danger small">{{ form_errors(form.sujet) }}</div>
                                </div>

                                {# Description #}
                                <div class="mb-3">
                                    <label class="fw-bold mb-1">Description détaillée :</label>
                                    {{ form_widget(form.description, {
                                        'attr': {
                                            'class': 'form-control border-secondary-subtle',
                                            'rows': '5',
                                            'placeholder': 'Expliquez-nous votre problème ici...'
                                        }
                                    }) }}
                                    <div class="text-danger small">{{ form_errors(form.description) }}</div>
                                </div>

                                {# Type #}
                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="fw-bold mb-1">Type de réclamation :</label>
                                        {{ form_widget(form.type, {
                                            'attr': {
                                                'class': 'form-select border-secondary-subtle'
                                            }
                                        }) }}
                                        <div class="text-danger small">{{ form_errors(form.type) }}</div>
                                    </div>
                                </div>

                                <hr class="my-4 opacity-25">

                                {# Actions #}
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" onclick="showCreateForm()" class="btn btn-light border px-4">Annuler</button>
                                    
                                    <button type="submit" class="btn btn-save px-5 fw-bold shadow-sm">
                                        <i class="fas fa-paper-plane me-2"></i> Envoyer la réclamation
                                    </button>
                                </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHAT -->
            <div id="view-chat" style="display:none; flex-direction:column; height:100%;">
                <div class="bg-dark text-white p-3 fw-bold d-flex justify-content-between align-items-center">
                    <span id="active-title">Discussion</span>
                    <button class="btn btn-sm btn-outline-light" onclick="showCreateForm()">✕</button>
                </div>

                <div class="chat-messages" id="chat-box"></div>

                <div class="p-3 border-top bg-white">
                    <form id="reply-form" method="POST" class="d-flex gap-2">
                        <input type="hidden" name="_token" value="">
                        <input type="text" name="message" required class="form-control rounded-pill" placeholder="Votre réponse...">
                        <button type="submit" class="btn btn-warning text-white rounded-circle" style="width:48px;height:48px;">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
function showCreateForm() {
    document.getElementById('view-create').style.display = 'block';
    document.getElementById('view-chat').style.display = 'none';
    document.querySelectorAll('.ticket-item').forEach(el => el.classList.remove('active'));
}

function loadChat(id, sujet) {
    document.getElementById('view-create').style.display = 'none';
    const chatView = document.getElementById('view-chat');
    chatView.style.display = 'flex';

    document.getElementById('active-title').innerText = sujet;

    document.querySelectorAll('.ticket-item').forEach(el => el.classList.remove('active'));
    let active = document.getElementById('ticket-' + id);
    if(active) active.classList.add('active');

    const dataElement = document.getElementById('data-' + id);
    if (!dataElement) return;

    let data = JSON.parse(dataElement.textContent);

    let form = document.getElementById('reply-form');
    form.action = data.replyUrl;
    form.querySelector('input[name="_token"]').value = data.token;

    let box = document.getElementById('chat-box');
    box.innerHTML = '';

    data.messages.forEach(m => {
        let div = document.createElement('div');
        div.className = 'bubble ' + (m.type === 'user' ? 'bubble-user' : 'bubble-admin');
        div.innerHTML = `
            <div>${m.msg}</div>
            <small>${m.time}</small>
        `;
        box.appendChild(div);
    });

    box.scrollTop = box.scrollHeight;
}

document.addEventListener('DOMContentLoaded', function(){
    let params = new URLSearchParams(window.location.search);
    let openId = params.get('open_chat');
    if(openId) {
        let el = document.getElementById('ticket-' + openId);
        if(el) el.click();
    }
});
</script>
{% endblock %}